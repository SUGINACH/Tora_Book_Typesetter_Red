{
  "name": "tora-book-typesetter-red",
  "version": "0.1.0",
  "private": true,
  "description": "Tora Book Typesetter RED — the definitive rebuild (engine core + full UI, zero runtime dependencies)",
  "scripts": {
    "test": "node ../tools/run-tests.js",
    "test:unit": "node tests/unit/parser.test.js && node tests/unit/document-structure.test.js && node tests/unit/typography.test.js",
    "test:settings": "node tests/integration/registry.test.js",
    "test:layout": "node tests/layout/s5-s6.test.js",
    "test:e2e": "node tests/e2e/pipeline.test.js && node tests/e2e/s7-notes.test.js && node tests/e2e/s8-decoration.test.js && node tests/e2e/s9-headers.test.js",
    "test:audit": "node tests/audit/negative-controls.test.js && node tests/e2e/s14-layout-audit.test.js",
    "test:ornaments": "node tests/e2e/s8-decoration.test.js",
    "test:headers": "node tests/e2e/s9-headers.test.js",
    "test:canonical": "node tests/e2e/canonical.test.js",
    "test:determinism": "node -e \"const{typeset}=require('./src/engine/core/pipeline');const{getDefaultSettings}=require('./src/engine/core/settings-registry');const fs=require('fs');const t=fs.readFileSync('tests/fixtures/canonical_corpus.txt','utf8');const a=typeset(t,getDefaultSettings());const b=typeset(t,getDefaultSettings());if(a.layoutHash!==b.layoutHash){console.error('NON-DETERMINISTIC');process.exit(1)}console.log('deterministic OK',a.layoutHash.slice(0,16),'pages:',a.pages.length)\"",
    "test:ui": "node tests/e2e/s10-ui.test.js && node tests/e2e/a1-run-summary.test.js && node tests/e2e/a1-input-integrity.test.js && node tests/e2e/a1-boot-failure.test.js",
    "test:extensions": "node tests/e2e/s11-extensions.test.js",
    "test:scan": "node ../tools/scan-control-triggers.js",
    "test:export": "node tests/e2e/s12-export.test.js",
    "test:acceptance": "node tests/e2e/s13-acceptance.test.js && node tests/audit/s13-security-a11y.test.js",
    "test:regress": "node ../tools/run-tests.js --suite regress",
    "audit:layout": "node tests/e2e/s14-layout-audit.test.js"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  }
}